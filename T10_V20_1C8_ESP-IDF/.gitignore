# Boot splash is per-user content: never commit either the source PNG or the
# generated header. The build regenerates main/boot_image.h every time (from
# boot_image.png if present, else the built-in default splash).
boot_image.png
main/boot_image.h

# uv venv used for the image conversion (recreated by `make`).
.venv/

# Your WAV clips + the header the build generates from them (per-user content).
audio_clips/
main/audio_clips.h
